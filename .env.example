# Copy to .env.local and fill in. Never commit .env.local.

# Public origin of the site, used for canonical and hreflang URLs.
SITE_URL=http://localhost:3000

# --- Used from phase 3 onward ---
# Anthropic API key and vision model (the model name lives only here, never in code).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# claude | mock — mock shows a visible "demo mode" banner and is never stored as history.
ANALYZER=claude

# --- Used from phase 5 onward ---
DATABASE_URL=file:./data/sakinah.db

# --- Used from phase 6 onward (the sampler stays off unless both are set) ---
SAMPLER_STREAM_URL=
SAMPLER_INTERVAL_MIN=
